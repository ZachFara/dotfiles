{
  "agentPushNotifEnabled": true,
  "autoCompactEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public (no remote configured for this repo — treat as local-only, not published)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: (unknown — origin/HEAD unset, no remote configured)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo only — /Users/user1/.config/sketchybar has no configured remotes",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (sketchybar/aerospace macOS configuration and tooling)",
      "**Trusted repo**: /Users/user1/.config/sketchybar (no remote configured — local-only checkout)",
      "**Org-specific CLIs**: None configured (project-specific tools observed: sketchybar, aerospace)",
      "**routine under <user>/ prefix**: none identified"
    ]
  },
  "effortLevel": "high",
  "enabledPlugins": {
    "code-review-anthropics@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/Development/active/cost-lens/plugin"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook Notification",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"/Users/user1/Development/active/AgentCommons/.venv/bin/commons\" hook post-tool-use",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook PostToolUse",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "\"/Users/user1/Development/active/AgentCommons/.venv/bin/commons\" hook post-tool-use-failure",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook PreToolUse",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook SessionEnd",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"/Users/user1/Development/active/AgentCommons/.venv/bin/commons\" hook session-start",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook SessionStart",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"/Users/user1/Development/active/AgentCommons/.venv/bin/commons\" hook stop",
            "timeout": 60,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook Stop",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook SubagentStop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/user1/go/bin/curia hook UserPromptSubmit",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "fable",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "mcp__curia__search_decisions",
      "mcp__curia__request_decision",
      "mcp__curia__check_decision",
      "mcp__curia__withdraw_decision"
    ]
  },
  "pluginConfigs": {
    "cost-lens": {
      "options": {
        "llmFeatures": true
      }
    },
    "cost-lens@inline": {
      "options": {
        "llmFeatures": true,
        "recommendationAlerts": false
      }
    }
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
