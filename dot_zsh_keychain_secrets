# Secrets are stored in the macOS Keychain, not in dotfiles.
# Add or rotate one with:
#   security add-generic-password -U -a "$USER" -s "env:NAME" -w "VALUE"
# Names to recreate on a new machine are listed in ~/Ark/secrets/keychain-items.txt
if command -v security >/dev/null 2>&1 && [ -f "$HOME/.config/zsh/keychain-items.txt" ]; then
  while IFS= read -r _n; do
    [ -n "$_n" ] || continue
    _v="$(security find-generic-password -a "$USER" -s "env:$_n" -w 2>/dev/null)" && [ -n "$_v" ] && export "$_n=$_v"
  done < "$HOME/.config/zsh/keychain-items.txt"
  unset _n _v
fi
