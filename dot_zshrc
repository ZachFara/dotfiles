unalias tnew 2>/dev/null
unset -f tnew 2>/dev/null
tnew() {
  if [ -z "$1" ]; then
    echo "Usage: tnew <session-name>"
    return 1
  fi
  if [ -n "$TMUX" ]; then
    tmux new-session -ds "$1" && tmux switch-client -t "$1"
  else
    tmux new -s "$1"
  fi
}

