## My custom-made terminal functions

# Fuzzy finding functions
fnv() {
  local file
  file=$(find . -type f | fzf) # Use fzf to select the file
  if [[ -n $file ]]; then
    cd "$(dirname "$file")" # Change to the file's directory
    nvim "$(basename "$file")" # Open the file with nvim
  fi
}

fcd() {
  local dir
  dir=$(find . -type d | fzf) && cd "$dir"
}

# Waypoint functions

# Function to set a waypoint
function wp() {
  if [ -z "$1" ]; then
    echo "Usage: wp <name>"
    return 1
  fi
  mkdir -p ~/.waypoints
  echo "$(pwd)" > ~/.waypoints/$1
  echo "Waypoint '$1' set to $(pwd)"
}

function tp() {
  if [ -z "$1" ]; then
    echo "Usage: tp <name>"
    return 1
  fi
  if [ ! -f ~/.waypoints/$1 ]; then
    echo "Waypoint '$1' does not exist"
    return 1
  fi
  local target_dir
  target_dir=$(cat ~/.waypoints/$1)
  echo "Teleporting to '$target_dir'"
  cd "$target_dir" || return
}

# Function to list all waypoints
function lwp() {
  if [ ! -d ~/.waypoints ]; then
    echo "No waypoints set"
    return 1
  fi
  echo "Waypoints:"
  ls ~/.waypoints
}

# Clear all waypoints
function rmwp() {
  if [ ! -d ~/.waypoints ]; then
    echo "No waypoints to clear."
    return 1
  fi

  rm -f ~/.waypoints/*
  echo "All waypoints have been cleared."
}

# Logi Options+ backup/restore
LOGI_SRC="$HOME/Library/Application Support/LogiOptionsPlus"
LOGI_BACKUP_DIR="$HOME/Development/backups/logi_options_backups"

logi_backup() {
  local ts=$(date +"%Y%m%d_%H%M%S")
  mkdir -p "$LOGI_BACKUP_DIR"
  cp "$LOGI_SRC/settings.db"    "$LOGI_BACKUP_DIR/settings_${ts}.db"
  cp "$LOGI_SRC/macros.db"      "$LOGI_BACKUP_DIR/macros_${ts}.db"
  cp "$LOGI_SRC/config.json"    "$LOGI_BACKUP_DIR/config_${ts}.json"
  cp "$LOGI_SRC/cc_config.json" "$LOGI_BACKUP_DIR/cc_config_${ts}.json"
  echo "Logi Options+ backed up ($ts)"
}

logi_restore() {
  local latest=$(ls -t "$LOGI_BACKUP_DIR"/settings_*.db 2>/dev/null | head -1)
  if [[ -z "$latest" ]]; then
    echo "No backup found in $LOGI_BACKUP_DIR"
    return 1
  fi
  local ts=${latest##*/settings_}
  ts=${ts%.db}
  echo "Restoring from backup: $ts"
  osascript -e 'quit app "Logi Options+"' 2>/dev/null
  sleep 2
  cp "$LOGI_BACKUP_DIR/settings_${ts}.db"    "$LOGI_SRC/settings.db"
  cp "$LOGI_BACKUP_DIR/macros_${ts}.db"      "$LOGI_SRC/macros.db"
  cp "$LOGI_BACKUP_DIR/config_${ts}.json"    "$LOGI_SRC/config.json"
  cp "$LOGI_BACKUP_DIR/cc_config_${ts}.json" "$LOGI_SRC/cc_config.json"
  echo "Restored. Relaunch Logi Options+ to apply."
}

